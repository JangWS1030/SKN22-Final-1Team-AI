HF_TOKEN=your_token_here

# RunPod Serverless 테스트용
RUNPOD_API_KEY=your_key_here
RUNPOD_ENDPOINT_ID=42giqi5gbhd6qe
DOCKER_IMAGE_REPO=byoungj/sd

# SAM2 사용 시 1로 설정 (0으로 설정하면 BiSeNet-only 모드)
ENABLE_SAM2=1

# 비워두면 기본값은 pretrained_models/sam2.pt 입니다.
SAM2_CHECKPOINT_PATH=

# 설치 스크립트 옵션 예시
INSTALL_SAM2=1
DOWNLOAD_MISSING_WEIGHTS=1

# 완식's 모델
SEGFACE_HF_REPO_ID=siik/segface_hair_khairstyle
SEGFACE_HF_SUBFOLDER=swinb_celeba_512
SEGFACE_HF_FILENAME=model_299.pt


# crawling
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
